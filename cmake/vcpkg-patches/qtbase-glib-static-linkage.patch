diff --git a/ports/qtbase/qtbase-static-xcb-private-deps.patch b/ports/qtbase/qtbase-static-xcb-private-deps.patch
new file mode 100644
--- /dev/null
+++ b/ports/qtbase/qtbase-static-xcb-private-deps.patch
@@ -0,0 +1,20 @@
+diff --git a/cmake/3rdparty/extra-cmake-modules/find-modules/FindXCB.cmake b/cmake/3rdparty/extra-cmake-modules/find-modules/FindXCB.cmake
+index 0c546d0..9212bad 100644
+--- a/cmake/3rdparty/extra-cmake-modules/find-modules/FindXCB.cmake
++++ b/cmake/3rdparty/extra-cmake-modules/find-modules/FindXCB.cmake
+@@ -177,6 +177,15 @@ ecm_find_package_parse_components(XCB
+ ecm_find_package_handle_library_components(XCB
+     COMPONENTS ${XCB_components}
+ )
++# ECM uses pkg-config only as a search hint and does not copy its transitive
++# link libraries to imported targets. Static libxcb needs the private Xau and
++# Xdmcp dependencies that vcpkg records in PKG_XCB_XCB_LINK_LIBRARIES.
++if(NOT BUILD_SHARED_LIBS AND TARGET XCB::XCB AND PKG_XCB_XCB_LINK_LIBRARIES)
++    set(_xcb_static_link_libraries ${PKG_XCB_XCB_LINK_LIBRARIES})
++    list(REMOVE_ITEM _xcb_static_link_libraries "${XCB_XCB_LIBRARY}" xcb)
++    set_property(TARGET XCB::XCB APPEND PROPERTY
++        INTERFACE_LINK_LIBRARIES "${_xcb_static_link_libraries}")
++endif()
+
+ find_package_handle_standard_args(XCB
+     FOUND_VAR
diff --git a/ports/glib/portfile.cmake b/ports/glib/portfile.cmake
--- a/ports/glib/portfile.cmake
+++ b/ports/glib/portfile.cmake
@@ -111,1 +111,18 @@
 vcpkg_fixup_pkgconfig()
+if(VCPKG_LIBRARY_LINKAGE STREQUAL "static" AND VCPKG_TARGET_IS_LINUX)
+    file(GLOB glib_pkgconfig_files
+        "${CURRENT_PACKAGES_DIR}/lib/pkgconfig/*.pc"
+        "${CURRENT_PACKAGES_DIR}/debug/lib/pkgconfig/*.pc"
+    )
+    foreach(pc_file IN LISTS glib_pkgconfig_files)
+        vcpkg_replace_string("${pc_file}"
+            "[/A-Za-z0-9_.:+-]*libatomic[.]so([.][0-9]+)*"
+            "-Wl,-l:libatomic.a"
+            REGEX
+            IGNORE_UNCHANGED
+        )
+        vcpkg_replace_string("${pc_file}" "-latomic" "-Wl,-l:libatomic.a" IGNORE_UNCHANGED)
+    endforeach()
+endif()
+
